[ ca ]
default_ca = CA_default
[ CA_default ]
database = /runtime/tls/index.txt
new_certs_dir = /runtime/tls/newcerts
serial = /runtime/tls/serial
crlnumber = /runtime/tls/crlnumber
certificate = /runtime/tls/root.crt
private_key = /runtime/tls/root.key
default_md = sha256
default_days = 2
default_crl_days = 2
policy = policy_any
copy_extensions = copy
[ policy_any ]
commonName = supplied
[ server_ext ]
subjectAltName = DNS:target,IP:127.0.0.1
extendedKeyUsage = serverAuth
